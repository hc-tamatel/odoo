<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ponderado_operativo" model="ir.module.category">
            <field name="name">Soporte Operativo (Ponderado)</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_ponderado_viewer" model="res.groups">
            <field name="name">Visualizador</field>
            <field name="category_id" ref="module_category_ponderado_operativo"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ponderado_editor" model="res.groups">
            <field name="name">Editor</field>
            <field name="category_id" ref="module_category_ponderado_operativo"/>
            <field name="implied_ids" eval="[(4, ref('group_ponderado_viewer'))]"/>
        </record>

        <record id="group_ponderado_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_ponderado_operativo"/>
            <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_manager'))]"/>
        </record>
    </data>
</odoo>