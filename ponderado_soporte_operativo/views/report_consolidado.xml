<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_helpdesk_ticket_consolidado_list" model="ir.ui.view">
            <field name="name">helpdesk.ticket.consolidado.list</field>
            <field name="model">helpdesk.ticket</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <list string="Consolidado de Reportes" 
                      multi_edit="1" 
                      export_xlsx="1"
                      create="0"
                      delete="0"
                      import="0">
                    
                    <field name="is_quoted" 
                           string="¿Cotizado?" 
                           widget="boolean_toggle" 
                           optional="show"
                           readonly="0" 
                           groups="ponderado_soporte_operativo.group_ponderado_editor"/>

                    <field name="id" string="N° Ticket" optional="show" options="{'format': false}" readonly="1"/>
                    <field name="name" string="Nombre"/>
                    <field name="partner_id" string="Cliente"/>

                    <field name="x_studio_pm" optional="show" widget="badge" decoration-info="1"/>
                    <field name="x_studio_ingeniero_1" optional="show" widget="many2many_tags"/>
                    <field name="x_studio_proyecto_macro" optional="show" widget="many2many_tags"/>
                    <field name="x_studio_proyecto_2" string="Proyecto" optional="show"/>
                    <field name="x_studio_sub_proyecto_1" optional="show"/>
                    <field name="x_studio_n_hito_sgr" optional="show" widget="many2many_tags"/>
                    <field name="x_studio_sitio_de_actividad_pro_1" optional="show" widget="many2many_tags"/>

                    <field name="user_id" string="Analista Asignado" widget="many2one_avatar_user"/>
                    <field name="stage_id" widget="badge" decoration-info="True"/>

                    <field name="x_studio_fecha_cumplimiento_de_hito" optional="show"/>
                    <field name="create_date" string="Fecha Creación" optional="show" widget="date"/>
                    <field name="x_studio_fecha_final_entrega_de_informe" optional="show"/>

                </list>
            </field>
        </record>

        <record id="view_helpdesk_ticket_consolidado_search" model="ir.ui.view">
            <field name="name">helpdesk.ticket.consolidado.search</field>
            <field name="model">helpdesk.ticket</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <search string="Buscar Tickets">
                    <field name="id" string="ID Ticket"/>
                    <field name="name" string="Asunto"/>
                    <field name="partner_id" string="Cliente"/>
                    <field name="x_studio_pm" string="PM"/>
                    
                    <field name="x_studio_ingeniero_1" string="Ingeniero 1"/>
                    <field name="x_studio_proyecto_macro" string="Proyecto Macro"/>
                    <field name="x_studio_n_hito_sgr" string="N° Hito"/>
                    <field name="x_studio_sitio_de_actividad_pro_1" string="Sitio"/>
                    <field name="user_id" string="Asignado"/>

                    <separator/>
                    <filter string="Cotizados" name="quoted" domain="[('is_quoted', '=', True)]"/>
                    <filter string="No Cotizados" name="not_quoted" domain="[('is_quoted', '=', False)]"/>
                    <separator/>
                    
                    <filter string="Mis Tickets" name="my_tickets" domain="[('user_id', '=', uid)]"/>
                    <filter string="Abiertos" name="is_open" domain="[('stage_id.fold', '=', False)]"/>
                    <filter string="Cerrados" name="is_closed" domain="[('stage_id.fold', '=', True)]"/>
                    <separator/>

                    <group expand="0" string="Agrupar Por">
                        <filter string="Estado Cotización" name="group_quoted" context="{'group_by': 'is_quoted'}"/>
                        
                        <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Etapa" name="group_stage" context="{'group_by': 'stage_id'}"/>
                        <filter string="Ingeniero Asignado" name="group_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Proyecto" name="group_project_2" context="{'group_by': 'x_studio_proyecto_2'}"/>
                        
                        <filter string="Fecha Creación" name="group_create_date" context="{'group_by': 'create_date'}"/>
                        <filter string="Fecha Cumplimiento" name="group_cumplimiento" context="{'group_by': 'x_studio_fecha_cumplimiento_de_hito'}"/>
                        <filter string="Fecha Final Entrega" name="group_fecha_fin" context="{'group_by': 'x_studio_fecha_final_entrega_de_informe'}"/>

                        <separator/>
                        <filter string="Proyecto Macro" name="group_macro" context="{'group_by': 'x_studio_proyecto_macro'}"/>
                        <filter string="Ingeniero" name="group_ing1" context="{'group_by': 'x_studio_ingeniero_1'}"/>
                        <filter string="N° Hito" name="group_hito" context="{'group_by': 'x_studio_n_hito_sgr'}"/>
                        <filter string="Sitio" name="group_sitio" context="{'group_by': 'x_studio_sitio_de_actividad_pro_1'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_helpdesk_consolidado_report" model="ir.actions.act_window">
            <field name="name">Consolidado de Informes</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_helpdesk_ticket_consolidado_list"/>
            <field name="search_view_id" ref="view_helpdesk_ticket_consolidado_search"/>
            <field name="domain">[('team_id.name', '=', 'Soporte Operativo')]</field>
            <field name="context">{'search_default_is_open': 0}</field>
        </record>

        <menuitem id="menu_helpdesk_consolidado"
                  name="Consolidado de Informes"
                  parent="helpdesk.helpdesk_ticket_report_menu_main"
                  action="action_helpdesk_consolidado_report"
                  sequence="10"
                  groups="ponderado_soporte_operativo.group_ponderado_viewer"/> 

    </data>
</odoo>