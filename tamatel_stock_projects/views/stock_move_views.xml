<odoo>
    <record id="view_move_tree_tamatel" model="ir.ui.view">
        <field name="name">stock.move.list.tamatel</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="tm_macro_project_id" optional="show"/>
                <field name="tm_project_id" optional="show"/>
                <field name="tm_subproject_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_move_search_tamatel" model="ir.ui.view">
        <field name="name">stock.move.search.tamatel</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Macro Proyecto" name="groupby_macro" context="{'group_by': 'tm_macro_project_id'}"/>
                <filter string="Proyecto" name="groupby_project" context="{'group_by': 'tm_project_id'}"/>
            </xpath>
        </field>
    </record>
    
</odoo>