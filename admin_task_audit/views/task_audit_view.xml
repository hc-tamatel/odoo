<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_task_form_audit_inherit" model="ir.ui.view">
            <field name="name">project.task.form.audit.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='sub_tasks_page']" position="after">
                    
                    <page name="audit_admin"
                          string="Auditoría / Checklist">

                        <div class="d-flex align-items-center gap-2 mb-3" groups="project.group_project_manager">
                            <button name="action_load_audit_checklist" 
                                    type="object" 
                                    string="Cargar Checklist" 
                                    icon="fa-list-alt"
                                    class="btn btn-secondary shadow-sm"
                                    confirm="¿Estás seguro? Esto reemplazará la lista actual."/>
    
                            <button name="action_remove_unchecked_audit_lines" 
                                    type="object" 
                                    string="Borrar No Requeridos" 
                                    icon="fa-eraser" 
                                    class="btn btn-warning text-white shadow-sm"
                                    confirm="¿Desea eliminar todos los ítems que no están marcados como requeridos?"/>
    
                            <button name="action_clean_audit_checklist" 
                                    type="object" 
                                    string="Limpiar Todo" 
                                    icon="fa-trash"
                                    class="btn btn-danger shadow-sm"
                                    confirm="¿Estás seguro de que quieres eliminar todas las líneas de auditoría?"/>
                        </div>
                        <field name="checklist_line_ids" nolabel="1">
                            <list editable="bottom" 
                                  decoration-success="score == '75' or score == '100'" 
                                  decoration-warning="is_realizado and score not in ('75', '100')"
                                  decoration-danger="score == '0' and not is_realizado">
                                
                                <field name="sequence" widget="handle"/>
                                <field name="name" string="Ítem a Evaluar"/>
                                
                                <field name="is_checked" 
                                       groups="project.group_project_manager"/>
                                
                                <field name="user_id" 
                                       widget="many2one_avatar_user"
                                       options="{'no_create': True}"
                                       invisible="not is_checked"
                                       groups="project.group_project_manager"/>
                                
                                <field name="is_realizado"/>

                                <field name="attachment_ids" 
                                       widget="many2many_binary" 
                                       string="Adjuntos (Fotos)"
                                       invisible="not is_checked"
                                       groups="project.group_project_manager"/>
                                
                                <field name="score" 
                                       invisible="not is_checked"
                                       groups="project.group_project_manager"/>

                                <field name="observaciones" 
                                       invisible="not is_checked"
                                       groups="project.group_project_manager"/>
                            </list>
                        </field>

                        <group class="oe_subtotal_footer" groups="project.group_project_manager">
                            <field name="audit_final_avg" widget="progressbar"/>
                        </group>

                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>